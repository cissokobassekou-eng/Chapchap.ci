<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Inter,system-ui,sans-serif}
body{background:#FFF7F0;max-width:430px;margin:0 auto;min-height:100vh;position:relative}
header{background:#FF6B00;color:#fff;padding:20px 20px 24px;border-radius:0 0 24px 24px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:16px}
.card{border-radius:20px;padding:14px;color:#fff;cursor:pointer;position:relative;min-height:115px;transition:transform .1s}
.card:active{transform:scale(.96)}
.card h3{font-size:13px;margin-top:6px;font-weight:900}.card p{font-size:10.5px;opacity:.95;margin-top:3px;line-height:13px}
.tag{position:absolute;top:7px;right:7px;background:#fff;color:#000;font-size:8px;padding:3px 7px;border-radius:10px;font-weight:900}
.orange{background:#FF6B00}.green{background:#16a34a}.blue{background:#2563eb}.red{background:#ef4444}.purple{background:#7c3aed}.dark{background:#1e293b}.motoB{background:linear-gradient(135deg,#FF6B00,#ff9a3c)}.voitureB{background:linear-gradient(135deg,#0f172a,#334155)}
.page{display:none;background:#fff;min-height:100vh;padding-bottom:90px;animation:fade .2s}
.page.active{display:block}
@keyframes fade{from{opacity:0}to{opacity:1}}
.topbar{color:#fff;padding:14px 16px;display:flex;gap:12px;align-items:center;position:sticky;top:0;z-index:10}
.btn{width:calc(100% - 32px);margin:16px;background:#FF6B00;color:#fff;border:none;padding:16px;border-radius:16px;font-weight:900;font-size:15px;cursor:pointer;display:block;text-align:center}
.box{border:1px solid #f1f5f9;border-radius:16px;padding:14px;margin:10px 16px;background:#fff}
.duree{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin:10px 0}
.duree button{border:2px solid #e5e7eb;border-radius:12px;padding:10px;font-weight:800;background:#fff;cursor:pointer;font-size:13px}
.duree button.active{border-color:#FF6B00;background:#fff7ed;color:#FF6B00}
.pay3{background:#000;color:#fff;border-radius:16px;padding:14px;margin:12px 16px}
.story{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:12px 16px}
.story div{border:1px solid #eee;border-radius:12px;padding:10px;font-size:11px}
.story b{font-size:12px}
nav{position:fixed;bottom:0;max-width:430px;width:100%;background:#fff;border-top:1px solid #eee;display:flex;justify-content:space-around;padding:8px 0;z-index:20}
nav div{font-size:9px;text-align:center;cursor:pointer;opacity:.6}nav div.active{opacity:1;color:#FF6B00;font-weight:900}
</style>
</head>
